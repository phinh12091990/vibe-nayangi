# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG KẾT NỐI POSTGRESQL (MẪU / PLACEHOLDER CHO VIBE HOST & LOCAL)
# TUÂN THỦ ĐIỀU 2: KHÔNG HARDCODE MẬT KHẨU / CREDENTIALS THẬT VÀO KHO LƯU TRỮ
# CÁC THÔNG SỐ THẬT ĐƯỢC NẠP TRỰC TIẾP QUA BIẾN MÔI TRƯỜNG TRÊN TRANG QUẢN TRỊ HOST
# ==============================================================================

# Cách 1: Sử dụng chuỗi Connection String đầy đủ từ Vibe Host (Được khuyến nghị)
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=prefer

# Cách 2: Hoặc khai báo từng thông số cấu hình riêng rẽ (tương thích Vibe Host env):
PGHOST=your_db_host
PGPORT=5432
PGDATABASE=your_db_name
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGSSL=false

# Cấu hình tài khoản Quản trị viên (Master Admin) qua biến môi trường (Optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# Cấu hình cổng cho API Backend Server
PORT=3001
VITE_API_URL=http://localhost:3001
