# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG KẾT NỐI POSTGRESQL (VIBE HOST & LOCAL)
# TUÂN THỦ NGUYÊN TẮC: KHÔNG HARDCODE MẬT KHẨU / CREDENTIALS VÀO GIT
# ==============================================================================

# Cách 1: Sử dụng chuỗi Connection String đầy đủ từ Vibe Host (Được khuyến nghị)
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://vibe_user:vibe_password@103.138.88.12:5432/vibe_nayangi_db?sslmode=prefer

# Cách 2: Hoặc khai báo từng thông số cấu hình riêng rẽ (tương thích Vibe Host env):
PGHOST=103.138.88.12
PGPORT=5432
PGDATABASE=vibe_nayangi_db
PGUSER=vibe_user
PGPASSWORD=vibe_password
PGSSL=false

# Cấu hình cổng cho API Backend Server
PORT=3001
VITE_API_URL=http://localhost:3001
